{#
 # Vion override of event_full.html.twig.
 # - Adds the article-style section design fields (section_bg, section_layout,
 #   section_color, …) to Event items. The reader exposes the full row via
 #   setData(row()), so the fields are available as top-level variables.
 # - Mirrors mod_article / news_full: the section_* fields are concatenated into
 #   a preset and applied to the wrapper (now a <section>); layout-*/align-* are
 #   moved onto an inner wrapper for grid/flex display contexts.
 # - `.section` is only added when a design field is set, so the default output
 #   stays a plain block (just <div> → <section>).
 #}
{%- set _preset = [section_bg|default, section_color|default, section_size|default, (section_size|default ? 'space-inline-none-mobile' : null), section_layout|default, section_align_x|default, section_align_y|default, section_align|default, section_text|default, section_height|default]|filter(v => v)|join(' ') -%}
{%- set _containerClasses = _preset|split(' ')|filter(c => c starts with 'layout-' or c starts with 'align-items-' or c starts with 'align-content-' or c == 'align-all-center')|join(' ') -%}
{%- set _sectionClasses = _preset|split(' ')|filter(c => not (c starts with 'layout-') and not (c starts with 'align-items-') and not (c starts with 'align-content-') and c != 'align-all-center')|join(' ') -%}
{%- set _bgImageStyle = '' -%}
{%- set _bgImageClass = '' -%}
{%- if (section_bg|default) starts with 'bg-image' and section_bg_image|default -%}
    {%- set _bg_sm = figure(section_bg_image, [600,  0, 'proportional']) -%}
    {%- set _bg_md = figure(section_bg_image, [1200, 0, 'proportional']) -%}
    {%- set _bg_lg = figure(section_bg_image, [1920, 0, 'proportional']) -%}
    {%- if _bg_sm -%}
        {%- set _bgImageClass = 'has-bg-image' -%}
        {%- set _bgImageStyle = '--section-bg-sm: url(' ~ _bg_sm.image.img.src ~ '); --section-bg-md: url(' ~ _bg_md.image.img.src ~ '); --section-bg-lg: url(' ~ _bg_lg.image.img.src ~ ')' -%}
    {%- endif -%}
{%- endif -%}
{%- set _wrapper = [_sectionClasses, (_sectionClasses ? 'section' : null), 'ave-reader', 'event', 'layout_full', 'block', class|default|trim, _bgImageClass]|filter(v => v)|join(' ') -%}

<section class="{{ _wrapper }}"{% set _style = [extra_style|default, _bgImageStyle]|filter(v => v)|join('; ') %}{% if _style %} style="{{ _style }}"{% endif %}>

    {# When a section design is active (.section is on the outer wrapper), the
       section goes full-bleed via CSS. An inner .container reintroduces the
       max-width and gutter so content is centred. Title + date + location are
       inside the container but above any layout grid — same pattern as mod_article.
       When no design is active _sectionClasses is empty, no container is added,
       and the output is identical to standard events. #}
    {%- if _sectionClasses %}<div class="container">{% endif %}

    <h1>{{ title }}</h1>

    {% if recurring %}
        <p class="info recurring">{{ recurring|raw }}</p>
    {% else %}
        <p class="info"><time datetime="{{ datetime }}">{{ date }}{% if time %} {{ time }}{% endif %}</time></p>
    {% endif %}

    {% if location %}
        <p class="location">{{ location }}{% if address %} ({{ address }}){% endif %}</p>
    {% endif %}

    {%- if _containerClasses %}<div class="{{ _containerClasses }}">{% endif %}

    {% if details.invoke() %}
        {{ details.invoke()|raw }}
    {% else %}
        <div class="ce_text block">
            {% if not addBefore %}
                {{ teaser|default|sanitize_html('contao')|csp_inline_styles|insert_tag_raw }}
            {% endif %}

            {% if addImage %}
                {#- Das Beitragsbild steht oben und ist meist das größte Element
                    beim Laden (LCP) — also NICHT lazy, anders als die Vorgabe in
                    picture_default. -#}
                {{ include('@Contao/image.html.twig', {picture: picture|merge({img: picture.img|merge({loading: 'eager'})})}) }}
            {% endif %}

            {% if addBefore %}
                {{ teaser|default|sanitize_html('contao')|csp_inline_styles|insert_tag_raw }}
            {% endif %}
        </div>
    {% endif %}

    {% if enclosure %}
        <ul class="enclosure">
            {% for enclosure in enclosure %}
                <li class="download-element ext-{{ enclosure.extension }}">
                    <a href="{{ enclosure.href }}" title="{{ enclosure.title }}">{{ enclosure.link }} <span class="size">({{ enclosure.filesize }})</span></a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {%- if _containerClasses %}</div>{% endif %}
    <!-- [ave-reader-end] -->
    {%- if _sectionClasses %}</div>{% endif %}
    {#- KI-Hinweis am Hintergrundbild der Sektion (component/_ai_label), als
        letztes Kind wie in mod_article -#}
    {%- if _bgImageClass -%}
        {{- include('@Contao/component/_ai_label.html.twig', {ai_label: ave_ai_label(section_bg_image), ai_background: true}, with_context = false) -}}
    {%- endif %}
</section>

{% set schemaOrg = getSchemaOrgData.invoke() %}

{% if hasDetails.invoke() %}
    {% set schemaOrg = schemaOrg|merge({description: details.invoke()|html_to_plain_text}) %}
{% endif %}

{% do add_schema_org(schemaOrg) %}

{% if figure|default %}
    {% do add_schema_org({'@type': 'WebPage', primaryImageOfPage: figure.getSchemaOrgData()}) %}
{% endif %}
