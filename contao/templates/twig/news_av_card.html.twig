<article class="news news--card{{ class }}">
    {%- if addImage %}
        <div class="news__image">
            {{ include('@Contao/image.html.twig') }}
        </div>
    {%- endif %}
    <div class="news__body">
        <p class="news__meta">
            <time datetime="{{ datetime }}">{{ date }}</time>
            {%- if author %}<span class="news__author">{{ author }}</span>{% endif %}
        </p>
        <h2 class="news__title">
            {%- if link|default %}
                <a href="{{ link }}" title="{{ newsHeadline }}">{{ newsHeadline }}</a>
            {%- else %}
                {{- newsHeadline }}
            {%- endif %}
        </h2>
        {%- if hasTeaser %}
            <p class="news__teaser">{{ teaser|striptags|trim }}</p>
        {%- endif %}
        {%- if (hasText.invoke() or hasTeaser) and link|default %}
            {#- Der unsichtbare Zusatz macht aus „Weiterlesen“ einen Linktext, der
                ohne Umgebung verständlich ist (Screenreader-Linkliste, WCAG 2.4.4;
                Lighthouse „link-text“ bemängelte ihn am 14.10.2026). -#}
            <p class="news__cta"><a href="{{ link }}">Weiterlesen<span class="invisible">: {{ newsHeadline }}</span></a></p>
        {%- endif %}
    </div>
</article>
{%- if not hasReader %}
    {%- do add_schema_org(getSchemaOrgData.invoke()) %}
{%- endif %}
