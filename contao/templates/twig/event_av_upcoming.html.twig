<article class="event event--upcoming{{ classList|default }}">

    {%- if addImage %}
        {{- include('@Contao/image.html.twig') }}
    {%- endif %}

    <div class="event__body">

        <div class="event__meta">
            <time datetime="{{ datetime }}" class="event__date">
                {%- if endDate and endDate != startDate -%}
                    {%- if startDate|date('mY') == endDate|date('mY') -%}
                        {{- startDate|date('d.') -}}–{{- endDate|date('d.m.Y') -}}
                    {%- elseif startDate|date('Y') == endDate|date('Y') -%}
                        {{- startDate|date('d.m.') -}}–{{- endDate|date('d.m.Y') -}}
                    {%- else -%}
                        {{- startDate|date('d.m.Y') -}}–{{- endDate|date('d.m.Y') -}}
                    {%- endif -%}
                {%- else -%}
                    {{- date -}}
                {%- endif -%}
            </time>
            {%- if time %}<span class="event__time">{{ time }}</span>{% endif %}
            {%- if location %}<span class="event__location">{{ location }}</span>{% endif %}
        </div>

        <h3 class="event__title">
            {%- if href|default %}
                <a href="{{ href }}" title="{{ title }}"{{ target }}>{{ link|default(title) }}</a>
            {%- else %}
                {{- title }}
            {%- endif %}
        </h3>

        {%- if teaser|default %}
            <p class="event__teaser">{{ teaser|striptags|trim }}</p>
        {%- endif %}

    </div>

</article>

{%- if not hasReader %}
    {%- do add_schema_org(getSchemaOrgData.invoke()) %}
{%- endif %}
