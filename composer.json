{
    "name": "avando/ave",
    "description": "Avando AVE — theme framework for Contao 5.7 LTS and Contao 6",
    "type": "contao-bundle",
    "license": "proprietary",
    "keywords": [
        "contao",
        "contao-theme",
        "theme",
        "avando"
    ],
    "homepage": "https://ave-theme.avando-labs.de",
    "authors": [
        {
            "name": "Ulrich Braun",
            "email": "themes@avando-labs.de",
            "homepage": "https://avando-labs.de"
        }
    ],
    "support": {
        "email": "themes@avando-labs.de",
        "docs": "https://ave-theme.avando-labs.de/docs/"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7 || ^6.0",
        "enshrined/svg-sanitize": "^0.22 || ^1.0",
        "matthiasmullie/minify": "^1.3",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Avando\\AveBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Avando\\AveBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Avando\\AveBundle\\ContaoManager\\Plugin"
    }
}
